<Window x:Class="StorageScope.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="StorageScope" Icon="/StorageScope;component/Resources/AppIcon.ico" Width="1120" Height="800" MinWidth="740" MinHeight="560"
        Loaded="Window_Loaded">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Top" Margin="4,0,0,12">
        <StackPanel x:Name="ApplicationTitle" Orientation="Horizontal">
          <Image Source="/StorageScope;component/Resources/Logo.png" Width="36" Height="36" Margin="0,0,10,0" AutomationProperties.Name="Logo La Brioche"/>
          <TextBlock Text="StorageScope" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="VolumeTitle" Text="Vue d’ensemble — choisissez un volume" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
        <TextBlock x:Name="WorkflowSteps" Text="1. Analyser   →   2. Choisir   →   3. Vérifier   →   4. Nettoyer" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel>
        <ComboBox x:Name="DrivePicker" Width="260" SelectionChanged="DrivePicker_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock><Run Text="{Binding VolumeLabel, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding FreeLabel, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="ScanButton" Content="Analyser" Click="ScanButton_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
        <Button x:Name="CancelButton" Content="Annuler" Click="CancelButton_Click" IsEnabled="False"/>
        <Button Content="Actualiser" Click="RefreshButton_Click"/>
        <Button x:Name="CheckUpdateButton" Content="Mises à jour" Click="CheckUpdate_Click"/>
        <Button x:Name="HistoryButton" Content="Historique" Click="History_Click"/>
        <Button x:Name="OptionsButton" Content="⋯" ToolTip="Mises à jour et historique" AutomationProperties.Name="Options de StorageScope" Click="Options_Click" Visibility="Collapsed">
          <Button.ContextMenu><ContextMenu Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"><MenuItem Header="Filtres et tri" Click="ShowFilters_Click"/><MenuItem Header="Réinitialiser les filtres" Click="ResetFilters_Click"/><MenuItem Header="Rechercher des mises à jour" Click="CheckUpdate_Click"/><MenuItem Header="Historique local" Click="History_Click"/></ContextMenu></Button.ContextMenu>
        </Button>
      </WrapPanel>
    </DockPanel>

    <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button x:Name="InstallUpdateButton" Content="Mettre à jour et redémarrer" Click="InstallUpdate_Click"/><Button Content="Plus tard" Click="DismissUpdate_Click"/></WrapPanel><TextBlock x:Name="UpdateText" TextWrapping="Wrap"/></DockPanel>
    </Border>

    <Border x:Name="StatusPanel" Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ProgressBar x:Name="ScanProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}"/>
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ScanStatusText" Text="Choisissez un disque puis cliquez sur Analyser. Tout fonctionne hors ligne." TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock x:Name="SpaceStatusText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="DisplayFilterPanel" Margin="0,0,0,8">
      <WrapPanel>
        <TextBlock Text="Rechercher" VerticalAlignment="Center" Margin="4,0,4,0"/>
        <TextBox x:Name="ListSearch" Width="180" Margin="4" TextChanged="ListSearch_Changed" ToolTip="Nom, extension, chemin ou éditeur" AutomationProperties.Name="Rechercher dans les résultats"/>
        <ComboBox x:Name="ResultSort" Width="215" DisplayMemberPath="Label" SelectionChanged="DisplayFilter_Changed" AutomationProperties.Name="Ordre des résultats"/>
        <Button x:Name="FilterToggleButton" Content="Filtres" Click="ToggleFilters_Click" ToolTip="Filtrer par catégorie, taille et type"/>
      </WrapPanel>
      <WrapPanel x:Name="ExtraFilters" Visibility="Collapsed">
        <ComboBox x:Name="CategoryFilter" Width="195" DisplayMemberPath="Label" SelectionChanged="DisplayFilter_Changed" AutomationProperties.Name="Filtrer par catégorie"/>
        <ComboBox x:Name="MinimumSizeFilter" Width="150" DisplayMemberPath="Label" SelectionChanged="DisplayFilter_Changed" AutomationProperties.Name="Taille minimale"/>
        <ComboBox x:Name="EntryKindFilter" Width="150" DisplayMemberPath="Label" SelectionChanged="DisplayFilter_Changed" AutomationProperties.Name="Fichiers ou dossiers"/>
        <Button Content="Réinitialiser" Click="ResetFilters_Click"/>
      </WrapPanel>
    </StackPanel>
    <TabControl Grid.Row="1" x:Name="MainTabs">
      <TabItem Header="Vue d’ensemble">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <GroupBox MinWidth="170" Header="Espace identifié"><TextBlock x:Name="IdentifiedText" Text="—" FontSize="24" FontWeight="SemiBold"/></GroupBox>
            <GroupBox Header="Fichiers"><TextBlock x:Name="FilesText" Text="—" FontSize="24" FontWeight="SemiBold"/></GroupBox>
            <GroupBox Header="Dossiers"><TextBlock x:Name="DirectoriesText" Text="—" FontSize="24" FontWeight="SemiBold"/></GroupBox>
            <GroupBox Header="Refus d’accès"><TextBlock x:Name="ErrorsText" Text="—" FontSize="24" FontWeight="SemiBold"/></GroupBox>
          </WrapPanel>
          <GroupBox Grid.Row="1" Header="Fichiers les plus volumineux">
            <DataGrid x:Name="LargestFilesGrid" ItemsSource="{Binding LargestFiles}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Nom" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
                <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Taille" Binding="{Binding DisplaySize}" Width="120"/>
                <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Catégorie" Binding="{Binding Type}" Width="180"/>
                <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Emplacement" Binding="{Binding Path}" Width="3*"/>
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="Explorateur">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
            <Button Content="← Parent" Click="ParentButton_Click"/>
            <TextBox x:Name="ExplorerPathBox" Grid.Column="1" Margin="6,4" KeyDown="ExplorerPathBox_KeyDown"/>
            <TextBox x:Name="ExplorerSearchBox" Grid.Column="2" Margin="6,4" TextChanged="ExplorerSearchBox_TextChanged" ToolTip="Rechercher dans le dossier"/>
          </Grid>
          <DataGrid Grid.Row="1" x:Name="ExplorerGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="ExplorerGrid_MouseDoubleClick" Margin="0,8">
            <DataGrid.Columns>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Nom" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Taille" Binding="{Binding DisplaySize}" Width="120"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Type" Binding="{Binding Type}" Width="180"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Modifié" Binding="{Binding Modified}" Width="170"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Chemin" Binding="{Binding Path}" Width="3*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ouvrir" Click="OpenSelection_Click"/>
            <Button Content="Afficher dans l’Explorateur" Click="RevealSelection_Click"/>
            <Button Content="Mettre à la Corbeille…" Click="TrashSelection_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Catégories">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="4,0,4,8">
            <ComboBox x:Name="CategorySummary" DisplayMemberPath="Label" SelectionChanged="CategorySummary_Changed" AutomationProperties.Name="Choisir une catégorie et voir son espace total"/>
            <TextBlock Text="Les 500 plus gros fichiers de chaque catégorie sont conservés, indépendamment du classement global. Les filtres portent sur cette liste ; l’Explorateur permet de poursuivre l’examen." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="CategoryFilesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="RevealCategory_Click">
            <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,14,8,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Nom" Binding="{Binding Name}" Width="250" MinWidth="180"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Taille" Binding="{Binding DisplaySize}" Width="130" MinWidth="120"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Emplacement" Binding="{Binding Path}" Width="*" MinWidth="250"/>
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="2" Content="Afficher dans l’Explorateur" Click="RevealCategory_Click" HorizontalAlignment="Right"/>
        </Grid>
      </TabItem>

      <TabItem Header="Nettoyage conseillé">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="CleanupIntro" Text="Choisissez ce que vous souhaitez retirer. Les documents et sauvegardes restent décochés." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,4,4,6"/>
            <WrapPanel><Button Content="Sélectionner les temporaires reconnus" Click="SelectRecommended_Click"/><Button Content="Tout décocher" Click="ClearCleanup_Click"/><Button x:Name="DuplicateButton" Content="Rechercher des doublons…" Click="AnalyzeDuplicates_Click"/><TextBlock x:Name="CleanupSelectionText" VerticalAlignment="Center" Margin="8"/></WrapPanel>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="CleanupGrid" SelectionChanged="CleanupGrid_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
            <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,14,8,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}" AutomationProperties.Name="Sélectionner cet élément"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Élément" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Taille" Binding="{Binding DisplaySize}" Width="120"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Raison" Binding="{Binding Reason}" Width="2*"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Chemin" Binding="{Binding Path}" Width="3*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2">
            <TextBlock x:Name="CleanupDetails" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="6"/>
            <WrapPanel HorizontalAlignment="Right">
            <Button Content="Examiner dans l’Explorateur" Click="RevealCleanup_Click"/>
            <Button x:Name="CleanButton" Content="Vérifier et nettoyer…" Click="TrashCleanup_Click" IsEnabled="False"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Applications et jeux">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Désinstallation officielle · sauvegardes conservées par StorageScope · tailles déclarées ou mesurées après analyse, tailles inconnues en dernier." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,4,4,6"/><ComboBox x:Name="ApplicationSourceFilter" SelectionChanged="DisplayFilter_Changed" AutomationProperties.Name="Filtrer les applications par source" Margin="4,0,4,8"/></StackPanel>
          <DataGrid Grid.Row="1" x:Name="ApplicationsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Application / jeu" Width="2*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4"><Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Source" Binding="{Binding Source}" Width="140"/>
                <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Taille estimée" Binding="{Binding DisplaySize}" Width="125"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Éditeur et version" Binding="{Binding Details}" Width="2*"/>
              <DataGridTextColumn ElementStyle="{DynamicResource CellText}" Header="Emplacement" Binding="{Binding InstallLocation}" Width="3*"/>
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="2" x:Name="UninstallButton" Content="Vérifier la désinstallation…" HorizontalAlignment="Right" Click="UninstallApplication_Click"/>
        </Grid>
      </TabItem>
    </TabControl>
    </Grid>

    <StackPanel Grid.Row="4" Margin="4,10,4,0"><TextBlock x:Name="PrivacyFooter" Text="Analyse locale · aucune télémétrie · liens et fichiers cloud exclus du nettoyage" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CompactStatus" Text="{Binding Text,ElementName=ScanStatusText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/></StackPanel>
  </Grid>
</Window>
