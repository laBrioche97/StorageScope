<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StorageScope</AssemblyName>
    <RootNamespace>StorageScope.Windows</RootNamespace>
    <Version>3.4.2</Version>
    <StartupObject>StorageScope.Windows.EntryPoint</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../Packaging/Branding/StorageScope.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../Packaging/Branding/StorageScope.ico" Link="Resources/AppIcon.ico" />
    <Resource Include="../../Packaging/Branding/logo-brioche.png" Link="Resources/Logo.png" />
    <InternalsVisibleTo Include="StorageScope.Windows.Tests" />
    <AssemblyMetadata Include="UpdatePublisher" Value="$(StorageScopePublisher)" />
    <EmbeddedResource Include="../../Packaging/windows-update-public-key.pem" Condition="Exists('../../Packaging/windows-update-public-key.pem')" LogicalName="StorageScope.UpdatePublicKey" />
  </ItemGroup>
</Project>
